# Copy this file to `.env` at the repo root and fill in what you need.
# Everything has a working default; no key is required to run the terminal.

# --- App ---
APP_ENV=development
APP_DEBUG=true
API_HOST=127.0.0.1
API_PORT=8000
API_PREFIX=/api/v1

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Storage ---
# Relative SQLite paths resolve against the directory uvicorn is started from (backend/).
# Swap for Postgres later, e.g. postgresql+psycopg://terminal:terminal@localhost:5432/terminal
DATABASE_URL=sqlite:///./data/terminal.db

# --- Data providers (all free; see docs/DATA_SOURCES.md) ---
# Market data + news: yfinance. No key needed.
# Fundamentals: SEC EDGAR. The SEC asks for a User-Agent naming the app and a contact.
SEC_EDGAR_USER_AGENT=TradingTerminal your.email@example.com
# Macro: FRED. Optional. Without a key the public CSV endpoint is used.
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Frontend (read by Vite; must be prefixed with VITE_) ---
# Leave empty to use the dev-server proxy (/api -> backend).
VITE_API_BASE_URL=
